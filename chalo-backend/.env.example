# ============================================================
# Chalo Backend — Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
API_VERSION=v1

# --- Database (PostgreSQL) ---
# connection_limit: max connections in pool (default: num_cpus * 2 + 1)
# pool_timeout: seconds to wait for a connection before erroring (default: 10)
# Example with tuning: "postgresql://postgres:password@localhost:5432/chalo_db?schema=public&connection_limit=10&pool_timeout=20"
DATABASE_URL="postgresql://postgres:password@localhost:5432/chalo_db?schema=public"

# --- Redis (for rate limiting + caching) ---
REDIS_URL="redis://localhost:6379"

# --- Firebase Admin SDK ---
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
FIREBASE_DATABASE_URL="https://your-project.firebaseio.com"

# --- Razorpay ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# --- Google Maps ---
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# --- MSG91 (SMS / WhatsApp for SOS alerts) ---
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_SENDER_ID="CHALO"

# --- JWT / Auth ---
# Firebase handles auth tokens — no custom JWT needed
# But we sign internal service tokens if needed
INTERNAL_API_KEY="your_internal_api_key_for_service_to_service"

# --- Business Config (V1 defaults — also stored in DB for runtime changes) ---
COMMISSION_PERCENTAGE=15
SUBSCRIPTION_FEE_WEEKLY=199
SURGE_ENABLED=true
SETTLEMENT_DAYS=2

# --- Logging ---
LOG_LEVEL=debug
# Set LOG_TO_FILE=true to enable file transports (skip in Docker where stdout is collected)
LOG_TO_FILE=false

# --- CORS ---
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ============================================================
# SECRETS ROTATION GUIDE
# ============================================================
#
# Rotate the following secrets on a regular schedule:
#
# 1. RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET
#    - Frequency: Every 90 days
#    - Process: Generate new keys in Razorpay Dashboard → update env → redeploy
#    - Downtime: Zero — Razorpay supports dual active keys during rotation
#
# 2. INTERNAL_API_KEY
#    - Frequency: Every 90 days or after any team member departure
#    - Process: Generate via `openssl rand -hex 32` → update all consumers → redeploy
#
# 3. FIREBASE_SERVICE_ACCOUNT (JSON key file)
#    - Frequency: Every 180 days
#    - Process: Firebase Console → generate new key → replace file → redeploy
#    - Note: Old key remains valid until explicitly revoked
#
# 4. MSG91_AUTH_KEY
#    - Frequency: Every 180 days
#    - Process: MSG91 Dashboard → regenerate → update env → redeploy
#
# 5. DATABASE_URL (password component)
#    - Frequency: Every 90 days
#    - Process: Update PG password → update connection string → redeploy
#    - Note: Use `ALTER ROLE` with a brief maintenance window
#
# 6. GOOGLE_MAPS_API_KEY
#    - Frequency: On compromise only (restrict by IP/referrer in Google Cloud Console)
#
