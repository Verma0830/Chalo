# ============================================================
# Chalo Backend — Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
API_VERSION=v1

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/chalo_db?schema=public"

# --- Redis (for rate limiting + caching) ---
REDIS_URL="redis://localhost:6379"

# --- Firebase Admin SDK ---
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
FIREBASE_DATABASE_URL="https://your-project.firebaseio.com"

# --- Razorpay ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# --- Google Maps ---
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# --- JWT / Auth ---
# Firebase handles auth tokens — no custom JWT needed
# But we sign internal service tokens if needed
INTERNAL_API_KEY="your_internal_api_key_for_service_to_service"

# --- Business Config (V1 defaults — also stored in DB for runtime changes) ---
COMMISSION_PERCENTAGE=15
SUBSCRIPTION_FEE_WEEKLY=199
SURGE_ENABLED=true
SETTLEMENT_DAYS=2

# --- Logging ---
LOG_LEVEL=debug

# --- CORS ---
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
