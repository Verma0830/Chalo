// ============================================================
// Chalo — Prisma Database Schema
// PostgreSQL with PostGIS for geospatial queries
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum DriverPlanType {
  COMMISSION
  SUBSCRIPTION
}

enum RideStatus {
  REQUESTED        // Customer requested, searching for driver
  DRIVER_ASSIGNED  // Driver accepted, en route to pickup
  DRIVER_ARRIVED   // Driver at pickup location
  IN_PROGRESS      // Ride started, heading to destination
  COMPLETED        // Ride finished
  CANCELLED        // Ride cancelled by customer or driver
  NO_DRIVER        // No driver found within timeout
  SCHEDULED        // Scheduled for future
}

enum PaymentMethod {
  CASH
  UPI
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SettlementStatus {
  PENDING       // Within T+2 window
  PROCESSING    // Being processed
  SETTLED       // Transferred to driver
  FAILED        // Settlement failed — retry
}

enum WithdrawalMethod {
  BANK_TRANSFER   // UPI or NEFT
  CASH_AGENT      // Field agent cash delivery
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
}

enum CancellationBy {
  CUSTOMER
  DRIVER
  SYSTEM
}

enum CancellationReasonCode {
  // Driver-fault reasons — fee is waived, driver may be penalised
  DRIVER_ASKED_TO_CANCEL    // Driver pressured customer to cancel (driver gets cancellation count)
  DRIVER_NOT_MOVING         // Driver accepted but is not moving toward pickup
  DRIVER_WRONG_VEHICLE      // Vehicle doesn't match the listed details
  DRIVER_BEHAVIOUR          // Driver was rude, inappropriate, or unsafe

  // Customer-fault reasons — cancellation fee applies
  CHANGED_MIND              // Customer no longer wants the ride
  BOOKED_BY_MISTAKE         // Accidental booking
  OTHER                     // Free-text fallback — fee applies
}

enum SOSStatus {
  ACTIVE
  RESOLVED
  AUTO_RESOLVED
}

enum NotificationType {
  RIDE_REQUEST
  RIDE_STATUS
  PAYMENT
  SCHEDULED_REMINDER
  PROMO
  SYSTEM
}

// ============================================================
// CORE MODELS
// ============================================================

/// Core user account — shared between customers and drivers
model User {
  id                String    @id @default(cuid())
  phone             String    @unique
  name              String?
  email             String?
  role              UserRole
  languagePref      String    @default("pa") // "pa" = Punjabi, "en" = English
  isActive          Boolean   @default(true)
  fcmToken          String?                  // Firebase Cloud Messaging device token
  fcmTokenUpdatedAt DateTime?                // Last time FCM token was registered/refreshed
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  customerProfile   CustomerProfile?
  driverProfile     DriverProfile?
  ridesAsCustomer   Ride[]            @relation("CustomerRides")
  ridesAsDriver     Ride[]            @relation("DriverRides")
  sosAlerts         SOSAlert[]
  notifications     Notification[]
  otpVerifications  OTPVerification[]
  shareLinksCreated RideShareLink[]

  @@index([phone])
  @@index([role])
  @@map("users")
}

/// Customer-specific profile data
model CustomerProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  emergencyContactName   String?
  emergencyContactPhone  String?
  savedHomeLat           Float?
  savedHomeLng           Float?
  savedHomeAddress       String?
  savedWorkLat           Float?
  savedWorkLng           Float?
  savedWorkAddress       String?
  totalRides             Int      @default(0)
  cancellationCount      Int      @default(0)
  cancellationCooldownUntil DateTime?               // Set when serial canceller cooldown is active
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

/// Driver-specific profile data with verification docs
model DriverProfile {
  id                    String              @id @default(cuid())
  userId                String              @unique
  
  // Documents
  licenseNumber         String?
  licenseUrl            String?
  rcNumber              String?
  rcUrl                 String?
  aadharNumber          String?
  aadharUrl             String?
  bikePhotoUrl          String?
  vehicleNumber         String?
  vehicleModel          String?
  
  // Verification
  verificationStatus    VerificationStatus  @default(PENDING)
  verifiedAt            DateTime?
  rejectionReason       String?
  verificationNote      String?
  verificationMetadata  Json?
  
  // Plan
  planType              DriverPlanType      @default(COMMISSION)
  subscriptionExpiresAt DateTime?
  
  // Stats
  ratingAvg             Float               @default(0)
  ratingCount           Int                 @default(0)
  totalRides            Int                 @default(0)
  totalEarnings         Float               @default(0)
  driverCancellationCount Int               @default(0)
  driverCancellationCountDaily Int          @default(0)
  driverCancellationLastAt DateTime?
  driverAcceptCount     Int                 @default(0)  // Total rides accepted
  driverDeclineCount    Int                 @default(0)  // Total rides declined (explicit decline, not timeout)

  // Real-time state (also mirrored in Firebase RTDB for speed)
  isOnline              Boolean             @default(false)
  currentLat            Float?
  currentLng            Float?
  lastLocationUpdate    DateTime?
  
  // Bank details for withdrawals
  bankAccountName       String?
  bankAccountNumber     String?
  bankIfsc              String?
  upiId                 String?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  earnings  Earning[]
  withdrawals Withdrawal[]

  @@index([verificationStatus])
  @@index([isOnline])
  @@index([currentLat, currentLng])
  @@map("driver_profiles")
}

// ============================================================
// RIDE MODELS
// ============================================================

/// Core ride entity — tracks entire lifecycle from request to completion
model Ride {
  id                String        @id @default(cuid())
  
  // Participants
  customerId        String
  driverId          String?
  
  // Pickup
  pickupLat         Float
  pickupLng         Float
  pickupAddress     String
  
  // Drop
  dropLat           Float
  dropLng           Float
  dropAddress       String
  
  // Route
  distanceKm        Float?
  durationMins      Int?
  polyline          String?       // Encoded polyline for route rendering
  
  // Fare
  baseFare          Float
  surgeMultiplier   Float         @default(1.0)
  finalFare         Float
  commissionAmount  Float         @default(0)
  driverEarning     Float         @default(0)
  gstAmount         Float         @default(0)  // 5% GST on finalFare — internal accounting, not shown to customer/driver
  
  // Status
  status            RideStatus    @default(REQUESTED)
  
  // Payment
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  razorpayPaymentId String?
  razorpayOrderId   String?
  
  // Scheduling
  isScheduled       Boolean       @default(false)
  scheduledAt       DateTime?
  
  // Rating
  customerRating    Int?          // 1-5 stars given by customer to driver
  customerComment   String?
  driverRating      Int?          // 1-5 stars given by driver to customer
  driverComment     String?

  // OTP ride start — generated when driver is assigned, required to start ride
  rideStartOtp      String?       // 4-digit OTP sent to customer

  // Rating skip tracking — set when customer explicitly skips rating (never ask again)
  ratingSkippedAt   DateTime?

  // Manual ride flag
  isManualRide      Boolean       @default(false)
  
  // Cancellation
  cancelledBy             CancellationBy?
  cancellationReasonCode  CancellationReasonCode?  // Structured reason code (drives fee logic)
  cancellationReason      String?                  // Optional free-text note (used with OTHER)
  
  // Timestamps — every state transition is tracked
  requestedAt       DateTime      @default(now())
  driverAssignedAt  DateTime?
  driverArrivedAt   DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  customer          User          @relation("CustomerRides", fields: [customerId], references: [id])
  driver            User?         @relation("DriverRides", fields: [driverId], references: [id])
  rideEvents        RideEvent[]
  sosAlerts         SOSAlert[]
  earning           Earning?
  shareLinks        RideShareLink[]

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([isScheduled, scheduledAt])
  @@index([createdAt])
  @@map("rides")
}

/// Immutable event log for every ride state transition — audit trail
model RideEvent {
  id          String   @id @default(cuid())
  rideId      String
  eventType   String   // e.g., "REQUESTED", "DRIVER_ASSIGNED", "CANCELLED", "SOS_TRIGGERED"
  metadata    Json?    // Flexible JSON for event-specific data
  lat         Float?   // GPS at time of event
  lng         Float?
  createdAt   DateTime @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@index([eventType])
  @@map("ride_events")
}

// ============================================================
// FINANCIAL MODELS
// ============================================================

/// Per-ride earnings record for a driver
model Earning {
  id                String           @id @default(cuid())
  driverProfileId   String
  rideId            String           @unique
  
  grossAmount       Float            // Total fare
  commissionAmount  Float            // Platform cut (0 if subscription)
  netAmount         Float            // What driver receives
  
  settlementStatus  SettlementStatus @default(PENDING)
  settlementDueDate DateTime         // T+2 from ride completion
  settledAt         DateTime?
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id])
  ride          Ride          @relation(fields: [rideId], references: [id])

  @@index([driverProfileId])
  @@index([settlementStatus])
  @@index([settlementDueDate])
  @@map("earnings")
}

/// Driver withdrawal requests
model Withdrawal {
  id                String           @id @default(cuid())
  driverProfileId   String
  amount            Float
  method            WithdrawalMethod
  
  // Bank transfer details (if applicable)
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?
  transactionRef    String?
  
  status            WithdrawalStatus @default(REQUESTED)
  processedAt       DateTime?
  rejectionReason   String?
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@index([driverProfileId])
  @@index([status])
  @@map("withdrawals")
}

// ============================================================
// SAFETY MODELS
// ============================================================

/// SOS alert triggered by customer during active ride
model SOSAlert {
  id            String    @id @default(cuid())
  rideId        String
  userId        String    // Who triggered (typically customer)
  
  lat           Float
  lng           Float
  
  status        SOSStatus @default(ACTIVE)
  
  // What was sent
  alertSentTo   Json      // Array of { name, phone, channel: "SMS" | "WHATSAPP" }
  
  triggeredAt   DateTime  @default(now())
  resolvedAt    DateTime?

  ride Ride @relation(fields: [rideId], references: [id])
  user User  @relation(fields: [userId], references: [id])

  @@index([rideId])
  @@index([status])
  @@map("sos_alerts")
}

// ============================================================
// AUTH & COMMUNICATION MODELS
// ============================================================

/// OTP verification records
model OTPVerification {
  id          String    @id @default(cuid())
  userId      String?
  phone       String
  otpCode     String
  expiresAt   DateTime
  verified    Boolean   @default(false)
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([phone, otpCode])
  @@index([expiresAt])
  @@map("otp_verifications")
}

/// Push notification log
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?            // Payload for deep links
  isRead    Boolean          @default(false)
  sentAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([sentAt])
  @@map("notifications")
}

/// Shareable public tracking token for an active ride.
/// Family-facing links are time-limited and can be rotated by the customer.
model RideShareLink {
  id          String   @id @default(cuid())
  rideId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ride      Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([rideId, revokedAt])
  @@index([expiresAt])
  @@map("ride_share_links")
}

// ============================================================
// PLATFORM CONFIG — Runtime-configurable business rules
// ============================================================

/// Key-value config store — allows changing business rules without redeployment
model PlatformConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("platform_config")
}
